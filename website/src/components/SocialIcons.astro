---
/*
 * Starlight既定のSocialIconsの差し替え。GitHubアイコンの前にドキュメントへの導線を置く。
 * トップページ（splash）にはサイドバーが無く、ヘッダーに導線が無いとインストール手順しか
 * 無いサイトに見えてしまう。
 * このコンポーネントはヘッダー右側（スマホ幅では非表示）とモバイルメニューの下端の両方で描画される。
 */
import Default from "@astrojs/starlight/components/SocialIcons.astro";

const { id } = Astro.locals.starlightRoute;
const isCli = id === "cli" || id.startsWith("cli/");

const links = [
  { label: "ドキュメント", href: "/niwaterm/installation/", current: id !== "" && !isCli },
  { label: "CLI", href: "/niwaterm/cli/", current: isCli },
];
---

<nav class="site-nav" aria-label="サイト">
  {
    links.map(({ label, href, current }) => (
      <a {href} aria-current={current ? "true" : undefined}>
        {label}
      </a>
    ))
  }
</nav>
<Default />

<style>
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    white-space: nowrap;
  }

  a {
    font-size: var(--sl-text-sm);
    font-weight: 700;
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }

  a:hover,
  a[aria-current="true"] {
    color: var(--sl-color-white);
  }
</style>
