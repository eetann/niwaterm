---
type Feature = "workspace" | "config" | "extend" | "browser" | "cli" | "agent";

interface Props {
  title: string;
  href: string;
  linkLabel: string;
  /** public/screenshots/<feature>.png と見出しのアイコンを選ぶキー */
  feature: Feature;
  /** スクリーンショットの代替テキスト */
  alt: string;
}

const { title, href, linkLabel, feature, alt } = Astro.props;

/*
 * スクリーンショットは画像最適化（sharp）を通さずpublic/から配る。sharpはWSL（NixOS）で
 * libstdc++を見つけられず読み込めないため、astro:assets経由にするとローカルのビルドが止まる。
 * 幅・高さは読み込み前のレイアウトのずれを防ぐために実寸を書く
 */
const sizes: Record<Feature, [number, number]> = {
  workspace: [1486, 902],
  config: [658, 400],
  extend: [812, 493],
  browser: [1318, 800],
  cli: [1318, 800],
  agent: [560, 340],
};
const [width, height] = sizes[feature];
const src = `${import.meta.env.BASE_URL}screenshots/${feature}.png`;

/* 見出しの左に置くアイコン。1px前後の線で描き、ブランドの「線を正確に引く」に揃える */
const icons: Record<Feature, string> = {
  workspace:
    '<rect x="3" y="4" width="18" height="16"/><line x1="8" y1="4" x2="8" y2="20"/><line x1="14" y1="4" x2="14" y2="20"/><line x1="14" y1="12" x2="21" y2="12"/>',
  config: '<path d="M8 7l-5 5 5 5M16 7l5 5-5 5"/>',
  extend:
    '<rect x="3" y="4" width="18" height="16"/><line x1="15" y1="4" x2="15" y2="20"/><line x1="17.5" y1="9" x2="19" y2="9"/><line x1="17.5" y1="12" x2="19" y2="12"/><line x1="17.5" y1="15" x2="19" y2="15"/>',
  browser:
    '<rect x="3" y="4" width="18" height="16"/><line x1="3" y1="9" x2="21" y2="9"/><circle cx="6" cy="6.5" r="0.6"/><circle cx="8.5" cy="6.5" r="0.6"/>',
  cli: '<rect x="3" y="4" width="18" height="16"/><path d="M7 9l3 3-3 3M12 15h5"/>',
  agent: '<circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/>',
};
---

<article class="card">
  <img class="shot" {src} {alt} {width} {height} loading="lazy" decoding="async" />
  <div class="text">
    <div class="title">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        aria-hidden="true"
        set:html={icons[feature]}
      />
      <h3>{title}</h3>
    </div>
    <div class="desc"><slot /></div>
    <a href={href}>{linkLabel} →</a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--sl-color-gray-6);
  }

  /* 切り出した範囲ごとに縦横比がわずかに違うため、枠の比率を揃えて左上を基準に収める */
  .shot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1318 / 800;
    object-fit: cover;
    object-position: left top;
    background: var(--niwa-code-bg);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
  }

  .title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--sl-color-white);
  }

  .title svg {
    flex-shrink: 0;
  }

  h3 {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.5;
    font-weight: 700;
    color: var(--sl-color-white);
  }

  .desc,
  .desc :global(p) {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--sl-color-white);
  }

  .desc :global(code) {
    padding: 1px 4px;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    background: var(--sl-color-black);
    border-radius: 2px;
  }

  a {
    align-self: flex-start;
    padding-block: 0.25rem;
    font-size: 0.875rem;
    color: var(--sl-color-text-accent);
  }
</style>
