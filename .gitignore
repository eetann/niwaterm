node_modules/
# ルート直下のビルド成果物のみ。先頭の"/"が無いとdocs/build/まで巻き込む
/build/
dist/
artifacts/
*.tsbuildinfo

# electrobun 2.x: Hutchがプロジェクトへ投影するSDK devkit（~/.hutchの共有キャッシュから生成）
.hutch/

# scripts/build-tailwind.ts(preBuild)がビルドの度に生成するCSS
.tailwind-build/

# libghostty-vt ビルド成果物（zig build -Demit-lib-vt で再現）
vendor/

# mise: 環境依存の値（Windows側ユーザー名等）を上書きするローカル設定
mise.local.toml

# Hutch/cottontailがビルド時に作る一時ディレクトリ
.cottontail-tmp/

# プロジェクトローカル設定。中身は各自の作業レイアウト等の個人設定
.niwaterm/

# Storybookの静的ビルド成果物（bun run build-storybook）
storybook-static/

# playwright-cliのセッション出力（スナップショット・コンソールログ等）
.playwright-cli/

# ドキュメントサイト（Astro）が生成する型定義・キャッシュ。ビルド成果物のwebsite/dist/は上のdist/で除外済み
/website/.astro/
