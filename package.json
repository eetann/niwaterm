		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@storybook/react-vite": "^10.6.0",
		"@tailwindcss/cli": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "latest",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.1",
		"oxfmt": "^0.59.0",
		"oxlint": "^1.74.0",
