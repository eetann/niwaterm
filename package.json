{
	"name": "niwaterm",
	"version": "0.0.1",
	"description": "Terminal, multiplexer, and workspace integrated desktop app",
	"workspaces": ["packages/*"],
	"scripts": {
		"lint": "oxlint src packages .storybook",
		"lint:fix": "oxlint --fix src packages .storybook",
		"format": "oxfmt src packages .storybook",
		"format:check": "oxfmt --check src packages .storybook",
		"test": "bun test",
		"storybook": "storybook dev -p 6006",
